# ── Backend environment variables ──
# Copy to `.env` for local dev. In production (Render) set these in the dashboard.
# NEVER commit the real .env (it's gitignored).

# MongoDB connection string. Local dev example: mongodb://localhost:27017/food_track
# Production: your MongoDB Atlas SRV string (include the db name before the "?").
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/food_track

# Secret used to sign JWTs. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-string

# Anthropic API key for AI meal analysis.
ANTHROPIC_API_KEY=sk-ant-...

# Port the server listens on. Render assigns its own PORT automatically; locally
# this falls back to 3000 if unset. Use 5000 locally so it doesn't clash with CRA.
PORT=5000

# Allowed frontend origin(s) for CORS — your deployed frontend URL (no trailing slash).
# Production: your Vercel URL, e.g. https://my-nutrition-app.vercel.app
# Comma-separate to allow several (e.g. prod URL + a custom domain).
# localhost:3000 is always allowed for local dev.
CLIENT_URL=https://your-frontend.vercel.app

# Set to "production" on Render. Hides internal 5xx error details from users
# (errors are still logged). Leave unset locally for full error messages.
NODE_ENV=production

# Secret that unlocks the admin crash inbox (GET /api/error-report).
# Send it as the `x-admin-key` header or `?key=` query param. Leave empty to lock it.
ADMIN_REPORT_KEY=replace-with-a-long-random-string
