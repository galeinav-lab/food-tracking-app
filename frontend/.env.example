# ── Frontend environment variables (CRA) ──
# Copy to `.env` for local dev. CRA only exposes vars prefixed with REACT_APP_.
#
# IMPORTANT: these are baked into the static bundle at BUILD time, not read at
# runtime. On Vercel, set them in the project settings BEFORE building, and
# REDEPLOY whenever you change one. Do not put secrets here — anything REACT_APP_
# ends up publicly visible in the shipped JS.

# Base URL of the backend API (include the /api path segment, no trailing slash).
# Local dev: http://localhost:5000/api
# Production: your Render backend URL, e.g. https://my-nutrition-api.onrender.com/api
REACT_APP_API_URL=http://localhost:5000/api

# Friends-and-family TESTING build. "true" enables the crash reporter, friendly
# toasts, and the "Report a problem" button. Set to false (or remove) for a
# clean production build.
REACT_APP_TESTING=true
